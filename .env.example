# --- Core ---
APP_URL=https://your-domain.example
DATABASE_URL=postgres://workforce:CHANGE_ME@127.0.0.1:5432/workforce_os
REDIS_URL=redis://127.0.0.1:6379/3
# 32-byte key for AES-256-GCM credential encryption (hex)
ENCRYPTION_KEY=   # generate: openssl rand -hex 32
# Session JWT signing secret
AUTH_SECRET=   # generate: openssl rand -hex 32

# --- Claude auth
# Each workspace stores its own credential (Settings → Claude credential, Owner only, encrypted).
# The values below are an optional instance-wide FALLBACK for workspaces without their own credential.
# "oauth" uses CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`), "api_key" uses ANTHROPIC_API_KEY.
CLAUDE_AUTH_MODE=oauth
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Set to false so every workspace must bring its own credential (recommended when other people can sign up)
CLAUDE_INSTANCE_FALLBACK=true

# --- Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Language & time
# Time zone used to show dates and times in the UI and in "try again at" messages
APP_TIME_ZONE=Asia/Jakarta

# --- Worker
WORKER_CONCURRENCY=2
PER_EMPLOYEE_CONCURRENCY=1
STORAGE_DIR=./storage
LOG_LEVEL=info

# --- Docker Compose only
DOMAIN=your-domain.example
POSTGRES_PASSWORD=   # generate: openssl rand -hex 16

# Public self-service signup (Google sign-in also creates accounts only when allowed)
ALLOW_SIGNUP=false

# --- Instance isolation (dev/test only; leave unset in production)
# development|test enables the startup guard that refuses to run against production DATABASE_URL/REDIS_URL
WFOS_ENV=
# Namespace for BullMQ queue keys and Redis pub/sub channels (pub/sub ignores the DB index).
# Required when WFOS_ENV is set; production keeps it empty.
WFOS_NAMESPACE=
# Production env file the guard compares against (e.g. /root/apps/workforce-os/.env)
WFOS_PROD_ENV_FILE=
# Postgres URL of a role with CREATEDB; the integration tests create and drop throwaway databases with it
TEST_DATABASE_ADMIN_URL=

# --- Workspace mode (Claude Code in a per-task systemd sandbox; native install as root only)
# concurrent Workspace-mode runs on this host (each Claude Code process needs 300-500 MB)
WORKSPACE_CONCURRENCY=1
# per-run limits of the sandbox unit
WORKSPACE_MEMORY_MAX_MB=700
WORKSPACE_TASKS_MAX=256
WORKSPACE_CPU_QUOTA=100
WORKSPACE_RUNTIME_MAX_SEC=3600
# finished task workspaces are deleted after this many days (deliverables are kept)
WORKSPACE_RETENTION_DAYS=14

# --- Telegram bot (optional): notifications to linked users, Approve/Reject buttons for Admins, daily summary
# Create the bot with @BotFather. Register the webhook yourself after deploy (the app never calls setWebhook):
#   curl -s "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d url="$APP_URL/api/telegram/webhook" -d secret_token="$TELEGRAM_WEBHOOK_SECRET" \
#     -d 'allowed_updates=["message","callback_query"]'
TELEGRAM_BOT_TOKEN=
# random string Telegram sends back in X-Telegram-Bot-Api-Secret-Token (generate: openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=
# bot username without @, shown in Account → Telegram
TELEGRAM_BOT_USERNAME=
# local hour (APP_TIME_ZONE) for the daily summary
TELEGRAM_SUMMARY_HOUR=8

# --- Web Push (optional): notifications to installed/subscribed browsers
# generate once: pnpm --filter @wfos/worker exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# contact for the push services (mailto: or https:)
VAPID_SUBJECT=mailto:admin@your-domain.example

# --- Seed (pnpm db:seed; the Docker migrate step runs it on every start)
# by default the seed only loads model prices. SEED_DEMO=true also creates a demo owner (random password, printed
# once, must be changed at first login) and sample data. Set SEED_OWNER_PASSWORD (≥ 10 chars) to choose it yourself.
SEED_DEMO=false
# SEED_OWNER_EMAIL=
# SEED_OWNER_PASSWORD=

# --- Advanced (defaults are right for a standard install)
# Postgres connections per process
# DB_POOL_MAX=5
# key rotation: the old key, readable until `pnpm --filter @wfos/db cli rotate-key` re-encrypted everything
# ENCRYPTION_KEY_PREVIOUS=
# commit shown by /api/health when there is no .git (Docker images get it as a build arg)
# WFOS_COMMIT=
# Workspace-mode sandbox paths (auto-detected): state base, runtime sockets, Node prefix, runner bundle, Claude Code
# WFOS_STATE_BASE=
# WFOS_RUNTIME_DIR=
# WFOS_NODE_PREFIX=
# WFOS_RUNNER_DIR=
# WFOS_CLAUDE_DIR=
# Anthropic API the sandbox gateway forwards to
# WFOS_ANTHROPIC_UPSTREAM=
