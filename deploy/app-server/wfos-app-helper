# systemd unit
# ---------------------------------------------------------------------------

# next_cache_bind SLUG USER [SLOT]: prints "BindPaths=<app>/next-cache:<app>/releases/<sha>/.next/cache" for the
# release `current` points at (with a slot: next-cache-<slot>, for the release current-<slot> points at), resolved
# now, as root, or nothing when there is no such release or it has no .next. The release stays read-only for the app;
# only this folder is writable. Every path is checked without following links (the release's contents were written
# by the app's own build), and a missing .next/cache mount point is created by the app user, never by root.
# Diagnostics go to stderr (stdout is the bind line).
next_cache_bind() {
  local slug="$1" user="$2" slot="${3:-}" dir cur rel nc link
  dir="$(app_dir "$slug")"
  nc="$dir/$(nc_name "$slot")"
  link="$(cur_link "$slot")"
  cur="$(current_sha "$slug" "$slot")"
  [[ -n "$cur" ]] || return 0
  rel="$dir/releases/$cur"
  [[ -d "$rel" && ! -L "$rel" && "$(realpath -e -- "$rel")" == "$rel" ]] || fail "$link points at releases/$cur, which is not a release folder"
  [[ -e "$rel/.next" || -L "$rel/.next" ]] || return 0
  [[ -d "$rel/.next" && ! -L "$rel/.next" ]] || fail "releases/$cur/.next is not a folder: refusing to bind into it"
  if [[ -L "$rel/.next/cache" || (-e "$rel/.next/cache" && ! -d "$rel/.next/cache") ]]; then
    fail "releases/$cur/.next/cache is not a folder: refusing to bind onto it"
  fi
  if [[ "$(realpath -m -- "$rel/.next/cache")" != "$rel/.next/cache" ]]; then fail "releases/$cur/.next/cache resolves elsewhere"; fi
  if [[ ! -e "$nc" && ! -L "$nc" ]]; then
    run install -d -m 0700 -o "$user" -g "$user" "$nc" >&2
  else
    safe_dir "$nc"
  fi
  if [[ ! -e "$rel/.next/cache" ]]; then
    if [[ "$DRY" == 1 ]]; then
      echo "[dry-run] runuser -u $user -g $RUN_GROUP -- mkdir -m 0700 -- $rel/.next/cache" >&2
    else
      as_app "$user" mkdir -m 0700 -- "$rel/.next/cache" || fail "could not create releases/$cur/.next/cache"
    fi
  fi
  echo "BindPaths=$nc:$rel/.next/cache"
}

# cmd_unit_install NAME PORT MEM DB [SLOT]: without a slot wfos-app-<name>.service running `current` with
# start/<name>.sh; with one wfos-app-<name>-<slot>.service running current-<slot> with start/<name>-<slot>.sh and its
# own Next.js cache. Both slots share data/, cache/, the env file and the database.
cmd_unit_install() {
  local slug="$1" port="$2" mem="$3" db="$4" slot="${5:-}" cmd user dir after="" next_bind start what exec
  stdin_line 500 "unit-install"
  cmd="$LINE"
  [[ "$db" == 0 ]] || require_pg
  user="$(app_user "$slug")"
  dir="$(app_dir "$slug")"
  start="$(start_file "$slug" "$slot")"
  what="$slug"
  exec="/bin/sh $start"
  # both slots share the env file, and EnvironmentFile= wins over Environment=: a slot's own port is set on the
  # command itself, so a PORT in the env file can never send the green slot to blue's port
  if [[ -n "$slot" ]]; then
    what="$slug, $slot slot"
    exec="/usr/bin/env PORT=$port /bin/sh $start"
  fi
  check_app_dirs "$slug"
  require_user "$user"
  lock
  [[ "$DRY" == 1 || -d "$START_DIR" ]] || fail "$START_DIR is missing (re-run prepare.sh)"
  next_bind="$(next_cache_bind "$slug" "$user" "$slot")"
  # the start command runs as the app user inside the sandbox; root only writes it (never runs or sources it)
  printf '# Managed by wfos-app-helper unit-install (Workforce OS): the start command of wfos-app.json.\n%s\n' "$cmd" |
    write_file "$start" 0644 root:root
  [[ "$db" == 0 ]] || after=" postgresql@$C_PG_VERSION-apps.service"
  {
    cat << EOF
# Managed by wfos-app-helper (Workforce OS): rewritten by unit-install, removed by app-remove. Do not edit.
[Unit]
Description=Workforce OS app $what (port $port)
Wants=network-online.target
# the app firewall (nftables table inet wfos_apps) must be loaded; when it stops, the app stops too
Requires=wfos-apps-firewall.service
After=network-online.target wfos-apps-firewall.service$after
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Slice=$SLICE
User=$user
# primary group wfos-app-run: the firewall matches it (meta skgid)
Group=$RUN_GROUP
# refuses to start when the app firewall is not loaded ("+": runs outside the sandbox)
ExecStartPre=+/usr/sbin/nft list table inet wfos_apps
WorkingDirectory=$dir/$(cur_link "$slot")
ExecStart=$exec
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
MemoryMax=${mem}M
MemorySwapMax=0
CPUQuota=100%
TasksMax=256
# only its own port may be bound (another app cannot take over a stopped app's port)
SocketBindAllow=tcp:$port
SocketBindDeny=any
EOF
    sandbox_props "$slug" unit "$db" "" "$start"
    if [[ -n "$next_bind" ]]; then
      echo "# Next.js writes its runtime cache (images, ISR, fetch) into .next/cache: the only writable spot in the release"
      echo "$next_bind"
    fi
    echo "Environment=HOST=127.0.0.1 PORT=$port NODE_ENV=production"
    cat << EOF

[Install]
WantedBy=multi-user.target
EOF
  } | write_file "$(unit_path "$slug" "$slot")" 0644 root:root
  run systemctl daemon-reload
  run systemctl enable "$(unit_name "$slug" "$slot")"
  echo "unit $(unit_name "$slug" "$slot") installed"
}

require_unit() {
  [[ "$DRY" == 1 || -f "$(unit_path "$1" "${2:-}")" ]] || fail "app $1 has no unit $(unit_name "$1" "${2:-}") (unit-install first)"
}

# the unit's Next.js cache bind must still be the one next_cache_bind computes now (current may have moved without a
# unit-install, or the release may have changed); the same link checks run again
check_unit_bind() {
  local slug="$1" slot="${2:-}" want have
  want="$(next_cache_bind "$slug" "$(app_user "$slug")" "$slot")"
  have="$(grep -E "^BindPaths=$(app_dir "$slug")/$(nc_name "$slot"):" "$(unit_path "$slug" "$slot")" 2> /dev/null || true)"
  [[ "$want" == "$have" ]] || fail "the unit $(unit_name "$slug" "$slot") does not match its current release (run unit-install first)"
}

cmd_unit_action() {
  local action="$1" slug="$2" slot="${3:-}" unit
  unit="$(unit_name "$slug" "$slot")"
  require_unit "$slug" "$slot"
  case "$action" in
    # a stopped preview stays stopped after a reboot; a started one comes back
    unit-start | unit-restart)
      lock
      firewall_guard
      running_guard "$slug"
      [[ "$action" == unit-restart ]] || disk_guard
      check_app_dirs "$slug"
      check_unit_bind "$slug" "$slot"
      port_guard "$slug" "$slot"
      if [[ "$action" == unit-start ]]; then
        run systemctl enable --now "$unit"
      else
        run systemctl restart "$unit"
      fi
      ;;
    # no lock: stopping never waits for anything
    unit-stop) run systemctl disable --now "$unit" ;;
  esac
}

# unit_state UNIT: active, inactive or failed (a crash loop counts as failed). Dry-run: active when the test lists it.
unit_state() {
  local state sub
  if [[ "$DRY" == 1 ]]; then
    if unit_active "$1"; then echo active; else echo inactive; fi
    return 0
  fi
  state="$(systemctl show "$1" -p ActiveState --value 2> /dev/null || true)"
  sub="$(systemctl show "$1" -p SubState --value 2> /dev/null || true)"
  case "$state" in
    active | reloading | refreshing) echo active ;;
    failed) echo failed ;;
    # a crash loop: systemd waits RestartSec between tries
    activating) if [[ "$sub" == auto-restart ]]; then echo failed; else echo inactive; fi ;;
    *) echo inactive ;;
  esac
}

cmd_unit_status() {
  local unit
  unit="$(unit_name "$1" "${2:-}")"
  if [[ "$DRY" == 1 ]]; then
    run systemctl show "$unit" -p ActiveState -p SubState
    echo inactive
    return 0
  fi
  unit_state "$unit"
}

# slots NAME: one JSON line, read-only, for the worker's recovery and the v3 → v4 move of a live instance:
# {"legacy":{…},"blue":{…},"green":{…},"site":{"port":<proxied port or null>,"maintenance":<bool>} or null}, where
# legacy (the unit without a slot), blue and green are each {"unit":<unit file present>,"state":"active|inactive|
# failed","sha":<the release its current link points at, or null>}
cmd_slots() {
  local slug="$1" dir s key sha unit out="" site port maint=false
  dir="$(app_dir "$slug")"
  check_apps_root
  safe_dir "$dir" 1
  for s in "" blue green; do
    key="${s:-legacy}"
    sha=""
    if [[ -d "$dir" ]]; then sha="$(current_sha "$slug" "$s")"; fi
    unit=false
    if [[ -f "$(unit_path "$slug" "$s")" ]]; then unit=true; fi
    out+="${out:+,}\"$key\":{\"unit\":$unit,\"state\":\"$(unit_state "$(unit_name "$slug" "$s")")\",\"sha\":"
    if [[ -n "$sha" ]]; then out+="\"$sha\"}"; else out+="null}"; fi
  done
  site="$NGINX_SITES/wfos-app-$slug"
  if [[ -f "$site" && ! -L "$site" ]]; then
    port="$(sed -nE 's|^[[:space:]]*proxy_pass http://127\.0\.0\.1:([0-9]{1,5});$|\1|p' -- "$site" | head -1)"
    if grep -qxF -- "$MAINT_MARK" "$site"; then maint=true; fi
    out+=",\"site\":{\"port\":${port:-null},\"maintenance\":$maint}"
  else
    out+=",\"site\":null"
  fi
  printf '{%s}\n' "$out"
}

# ---------------------------------------------------------------------------
# health
# ---------------------------------------------------------------------------

cmd_health() {
  local port="$2" path="$3" code
  # as root: the app firewall keeps apps away from loopback, not root
  if [[ "$DRY" == 1 ]]; then
    run curl -q -s -o /dev/null -w '%{http_code}' --max-time 5 --max-redirs 0 --max-filesize 10485760 --noproxy '*' --proto =http "http://127.0.0.1:$port$path"
    code=000
  else
    # -q first: no ~/.curlrc of root; the code is printed even when curl stops early (e.g. a body over 10 MB)
    code="$(curl -q -s -o /dev/null -w '%{http_code}' --max-time 5 --max-redirs 0 --max-filesize 10485760 --noproxy '*' --proto =http "http://127.0.0.1:$port$path" 2> /dev/null || true)"
  fi
  [[ "$code" =~ ^[0-9]{3}$ ]] || code=000
  printf '{"status":%d}\n' "$((10#$code))"
  [[ "$code" == 2?? ]]
}

# ---------------------------------------------------------------------------
# nginx + certificates
# ---------------------------------------------------------------------------

# one user "preview" and a bcrypt hash (computed by Workforce OS): never a plain password
HTPASSWD_RE='^preview:\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}$'

# "http2 on;" from nginx 1.25.1, "listen ... http2" before
nginx_http2_directive() {
  local v ma mi pa
  v="$(nginx -v 2>&1 | sed -nE 's|.*nginx/([0-9]+)\.([0-9]+)\.([0-9]+).*|\1 \2 \3|p' || true)"
  if [[ -z "$v" ]]; then
    echo modern
    return 0
  fi
  read -r ma mi pa <<< "$v"
  if ((ma > 1 || (ma == 1 && (mi > 25 || (mi == 25 && pa >= 1))))); then echo modern; else echo legacy; fi
}

# the maintenance page prepare.sh installs (nginx reads it; the path is the same on every server)
MAINT_PAGE=/etc/wfos-apps/maintenance.html
# the line that marks a site showing the maintenance page (`slots` reads it)
MAINT_MARK="    # wfos-maintenance: the maintenance page is shown instead of the app"

# site_content SLUG PORT AUTH(0|1) MODE(http|full) INDEX(0|1) MAINT(0|1) DOMAIN [ALIAS...]: the nginx site of one
# instance. DOMAIN is proxied to 127.0.0.1:PORT (MAINT=1: answers 503 with the maintenance page instead); http (DOMAIN
# and every ALIAS) redirects to https://DOMAIN, and every ALIAS answers https with a 301 to https://DOMAIN too (same
# certificate). The redirects never use the request's Host.
site_content() {
  local slug="$1" port="$2" auth="$3" mode="$4" index="$5" maint="$6" domain="$7" h2 listen443 listen443v6 http2_line="" names realm=Preview
  shift 7
  local -a aliases=("$@")
  names="$domain"
  if ((${#aliases[@]} > 0)); then names+=" ${aliases[*]}"; fi
  [[ "$domain" == "$slug.$C_BASE_DOMAIN" ]] || realm=Private
  h2="$(nginx_http2_directive)"
  if [[ "$h2" == modern ]]; then
    listen443="listen 443 ssl;"
    listen443v6="listen [::]:443 ssl;"
    http2_line="    http2 on;"
  else
    listen443="listen 443 ssl http2;"
    listen443v6="listen [::]:443 ssl http2;"
  fi
  cat << EOF
# Managed by wfos-app-helper (Workforce OS): rewritten by publish, removed by unpublish. Do not edit.
server {
    listen 80;
    listen [::]:80;
    server_name $names;
EOF
  if [[ "$mode" == http ]]; then
    # before the certificate exists: only what certbot needs (it answers the challenge for every name here)
    cat << 'EOF'
    location / {
        return 404;
    }
}
EOF
    return 0
  fi
  cat << EOF
    location / {
        return 301 https://$domain\$request_uri;
    }
}

server {
    $listen443
    $listen443v6
$http2_line
    server_name $domain;

    ssl_certificate /etc/letsencrypt/live/$domain/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$domain/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:wfos_apps_ssl:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
EOF
  # previews stay out of search engines; a live site (--index) may be indexed
  if [[ "$index" == 0 ]]; then echo '    add_header X-Robots-Tag "noindex, nofollow" always;'; fi
  echo "    client_max_body_size 25m;"
  if [[ "$auth" == 1 ]]; then
    cat << EOF

    auth_basic "$realm";
    auth_basic_user_file /etc/wfos-apps/htpasswd/$slug;
EOF
  fi
  if [[ "$maint" == 1 ]]; then
    # every request gets 503 + Retry-After and the static page (the method becomes GET for the page); `return` runs
    # before basic auth, so the neutral page shows without the password; the app is not asked anything
    cat << EOF

$MAINT_MARK
    # (the app at 127.0.0.1:$port is not proxied while it is on)
    add_header Retry-After 60 always;
    add_header Cache-Control "no-store" always;
    error_page 503 /.wfos-maintenance.html;

    location / {
        return 503;
    }

    location = /.wfos-maintenance.html {
        internal;
        auth_basic off;
        alias $MAINT_PAGE;
        default_type text/html;
        charset utf-8;
    }
}
EOF
  else
    # the password is nginx's business: the app never sees it
    local strip_auth=""
    [[ "$auth" == 0 ]] || strip_auth=$'\n        proxy_set_header Authorization "";'
    cat << EOF

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$wfos_connection_upgrade;$strip_auth
        proxy_read_timeout 300s;
    }
}
EOF
  fi
  if ((${#aliases[@]} > 0)); then
    cat << EOF

# aliases: one certificate with $domain, a permanent redirect to it
server {
    $listen443
    $listen443v6
$http2_line
    server_name ${aliases[*]};

    ssl_certificate /etc/letsencrypt/live/$domain/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$domain/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:wfos_apps_ssl:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    return 301 https://$domain\$request_uri;
}
EOF
  fi
}

# the whole configuration nginx loads (`nginx -T`: every included file, each after a "# configuration file X:"
# line). A dry-run test with its own prefix gets the same shape from its files.
nginx_dump() {
  local f
  if [[ -n "$P" ]]; then
    for f in "$NGINX_DIR"/nginx.conf "$NGINX_ENABLED"/* "$NGINX_DIR"/conf.d/*.conf; do
      if [[ -f "$f" ]]; then
        echo "# configuration file $f:"
        cat -- "$f"
      fi
    done
    return 0
  fi
  if ! nginx -T 2> /dev/null; then
    [[ "$DRY" == 1 ]] || fail "nginx -T fails: fix the nginx configuration first"
  fi
}

# server_name_taken OWN WILD(0|1) NAME...: prints the first NAME that a site other than the app's own (file name OWN)
# already serves, anywhere in what nginx loads (NGINX_DUMP), and returns 0; returns 1 when none is taken. WILD=1 (a
# --domain publish) also counts another site's wildcard that covers NAME (*.example.com, .example.com, www.example.*):
# a live domain never takes over a name another product on this server answers. Previews are checked exactly (the
# catch-all of the preview domain is a wildcard by design). Regular expression names (~…) are not evaluated.
NGINX_DUMP=""
server_name_taken() {
  local own="$1" wild="$2"
  shift 2
  printf '%s\n' "$NGINX_DUMP" | awk -v names="$*" -v own="$own" -v wild="$wild" '
    /^# configuration file .*:$/ {
      f = $0; sub(/^# configuration file /, "", f); sub(/:$/, "", f)
      n = split(f, parts, "/"); skip = (parts[n] == own)
      next
    }
    skip { next }
    { sub(/#.*/, ""); buf = buf " " $0 }
    # does the server_name T cover D?
    function covers(t, d,    s) {
      if (t == d) return 1
      if (!wild) return 0
      if (substr(t, 1, 2) == "*.") {
        s = substr(t, 2)
        return length(d) > length(s) && substr(d, length(d) - length(s) + 1) == s
      }
      if (substr(t, 1, 1) == ".") {
        return d == substr(t, 2) || (length(d) > length(t) && substr(d, length(d) - length(t) + 1) == t)
      }
      if (length(t) > 2 && substr(t, length(t) - 1) == ".*") {
        s = substr(t, 1, length(t) - 1)
        return length(d) > length(s) && index(d, s) == 1
      }
      return 0
    }
    END {
      k = split(names, want, " ")
      n = split(buf, stmts, ";")
      for (i = 1; i <= n; i++) {
        s = stmts[i]
        gsub(/[{}]/, " ", s)
        if (match(s, /(^|[[:space:]])server_name[[:space:]]/)) {
          s = substr(s, RSTART + RLENGTH)
          m = split(s, toks, /[[:space:]]+/)
          for (j = 1; j <= m; j++) {
            t = tolower(toks[j])
            gsub(/^["\047]|["\047]$/, "", t)
            if (t == "") continue
            for (w = 1; w <= k; w++) if (covers(t, want[w])) hit[w] = 1
          }
        }
      }
      for (w = 1; w <= k; w++) if (hit[w]) { print want[w]; exit 0 }
      exit 1
    }'
}

# nginx -t, then reload; on failure put the previous site back (or remove the new one) and fail
nginx_apply() {
  local site="$1" enabled="$2" backup="$3"
  if [[ "$DRY" == 1 ]]; then
    run nginx -t
    run systemctl reload nginx
    return 0
  fi
  if nginx -t > /dev/null 2>&1; then
    systemctl reload nginx
    return 0
  fi
  if [[ -n "$backup" && -f "$backup" ]]; then
    mv -f -- "$backup" "$site"
  else
    rm -f -- "$site" "$enabled"
  fi
  { nginx -t > /dev/null 2>&1 && systemctl reload nginx; } || true
  fail "nginx rejected the configuration for $(basename -- "$site"); the previous configuration was restored"
}

# at most CERTS_PER_DAY new certificates a day on this server (Let's Encrypt limits are shared with other sites)
CERT_COUNT_FILE="" CERT_COUNT=0
cert_budget_check() {
  local c
  CERT_COUNT_FILE="$STATE_DIR/cert-count-$(date -u +%Y%m%d)"
  CERT_COUNT=0
  if [[ -f "$CERT_COUNT_FILE" && ! -L "$CERT_COUNT_FILE" ]]; then
    c="$(head -c 16 -- "$CERT_COUNT_FILE" | tr -cd '0-9')"
    CERT_COUNT=$((10#${c:-0}))
  fi
  ((CERT_COUNT < CERTS_PER_DAY)) || refuse cert_limit "$CERT_COUNT new certificates were requested today (at most $CERTS_PER_DAY a day)"
}
cert_budget_take() {
  local f
  for f in "$STATE_DIR"/cert-count-*; do
    if [[ -f "$f" && "$f" != "$CERT_COUNT_FILE" ]]; then run rm -f -- "$f"; fi
  done
  echo "$((CERT_COUNT + 1))" | write_file "$CERT_COUNT_FILE" 0600 root:root
}

# the DNS names a certificate covers: lower case, sorted, one per line (empty when it cannot be read)
cert_names() {
  openssl x509 -noout -ext subjectAltName -in "$1" 2> /dev/null | tr ',' '\n' |
    sed -nE 's/^[[:space:]]*DNS:([^[:space:]]+)[[:space:]]*$/\1/p' | tr 'A-Z' 'a-z' | sort -u || true
}

# the live domain instance SLUG last published (empty when none, or when the record is not a valid host name)
recorded_domain() {
  local f="$DOMAINS_DIR/$1" d=""
  if [[ -f "$f" && ! -L "$f" ]]; then IFS= read -r d < "$f" || true; fi
  if [[ ${#d} -le 253 && "$d" =~ $FQDN_RE ]]; then echo "$d"; fi
}

# drop_lineage CERT OWN: best effort `certbot delete --cert-name CERT` (never fails the caller). Kept when there is no
# such lineage, another instance's record names it, or a site other than OWN's still serves that name.
drop_lineage() {
  local cert="$1" own="$2" f d
  if [[ ${#cert} -gt 253 || ! "$cert" =~ $FQDN_RE ]]; then
    echo "warning: ${cert@Q} is not a certificate name; nothing deleted" >&2
    return 0
  fi
  if [[ ! -d "$LE_LIVE/$cert" ]]; then
    echo "no certificate $cert"
    return 0
  fi
  for f in "$DOMAINS_DIR"/*; do
    [[ -f "$f" && ! -L "$f" && "$(basename -- "$f")" != "$own" ]] || continue
    d=""
    IFS= read -r d < "$f" || true
    if [[ "$d" == "$cert" ]]; then
      echo "certificate $cert kept: instance $(basename -- "$f") uses it"
      return 0
    fi
  done
  if ! NGINX_DUMP="$(nginx_dump 2> /dev/null)"; then
    echo "warning: nginx -T fails; certificate $cert kept" >&2
    return 0
  fi
  if server_name_taken "wfos-app-$own" 0 "$cert" > /dev/null; then
    echo "certificate $cert kept: another nginx site serves $cert"
    return 0
  fi
  if [[ "$DRY" == 1 ]]; then
    run certbot delete --cert-name "$cert" --non-interactive
  elif certbot delete --cert-name "$cert" --non-interactive > /dev/null 2>&1; then
    echo "certificate $cert deleted"
  else
    echo "warning: certbot delete --cert-name $cert failed; delete it by hand" >&2
  fi
}

# cmd_publish SLUG PORT AUTH INDEX MAINT DOMAIN [ALIAS...]: DOMAIN empty = the preview name <slug>.<BASE_DOMAIN>;
# MAINT=1 serves the maintenance page instead of proxying to PORT (switching back is another publish without it)
cmd_publish() {
  local slug="$1" port="$2" auth="$3" index="$4" maint="$5" domain="$6" custom=0 site enabled htpasswd line="" backup="" cert
  local need_cert=0 taken have want nm
  shift 6
  local -a aliases=("$@") names=() certbot_args=()
  if [[ -n "$domain" ]]; then custom=1; else domain="$slug.$C_BASE_DOMAIN"; fi
  names=("$domain" "${aliases[@]}")
  if [[ "$auth" == 1 ]]; then
    stdin_line 200 "publish --auth"
    line="$LINE"
    [[ "$line" =~ $HTPASSWD_RE ]] || usage "publish --auth needs one htpasswd line on stdin: preview:\$2y\$… (bcrypt)"
  fi
  site="$NGINX_SITES/wfos-app-$slug"
  enabled="$NGINX_ENABLED/wfos-app-$slug"
  htpasswd="$HTPASSWD_DIR/$slug"
  cert="$LE_LIVE/$domain/fullchain.pem"
  want="$(printf '%s\n' "${names[@]}" | sort -u)"
  lock
  # guards first: nothing is written when one says no. A failing nginx -T stops here (exit 1).
  NGINX_DUMP="$(nginx_dump)"
  if taken="$(server_name_taken "wfos-app-$slug" "$custom" "${names[@]}")"; then
    refuse server_name_taken "another nginx site already serves $taken"
  fi
  if [[ ! -f "$cert" ]]; then
    need_cert=1
  elif [[ "$custom" == 1 ]]; then
    # one certificate for the domain and its aliases, exactly those names (a dropped alias leaves it too, so its
    # renewal never depends on a name that may no longer point here)
    command -v openssl > /dev/null || fail "openssl is missing (re-run prepare.sh)"
    have="$(cert_names "$cert")"
    if [[ "$have" != "$want" ]]; then
      need_cert=1
      echo "the certificate for $domain covers ${have//$'\n'/ } instead of ${want//$'\n'/ }: requesting it again"
    fi
  fi
  if [[ "$need_cert" == 1 ]]; then cert_budget_check; fi
  if [[ "$DRY" == 0 ]]; then
    [[ -d "$HTPASSWD_DIR" ]] || fail "$HTPASSWD_DIR is missing (re-run prepare.sh)"
    if [[ "$maint" == 1 ]] && [[ ! -f "$MAINT_PAGE" || -L "$MAINT_PAGE" ]]; then fail "$MAINT_PAGE is missing (re-run prepare.sh)"; fi
    if [[ -f "$site" ]]; then
      backup="$(mktemp "$NGINX_SITES/.wfos-backup.XXXXXX")"
      cp -p -- "$site" "$backup"
    fi
  fi
  if [[ "$auth" == 1 ]]; then
    printf '%s\n' "$line" | write_file "$htpasswd" 0640 root:www-data "1 line: user preview, bcrypt hash"
  else
    run rm -f -- "$htpasswd"
  fi
  # 1) no certificate yet: an HTTP-only site so certbot's nginx authenticator can answer the challenge (one
  #    certificate for every name; it counts once against the daily cap)
  if [[ "$need_cert" == 1 ]]; then
    cert_budget_take
    site_content "$slug" "$port" "$auth" http "$index" "$maint" "$domain" "${aliases[@]}" | write_file "$site" 0644 root:root
    run ln -sfn "$site" "$enabled"
    nginx_apply "$site" "$enabled" "$backup"
    certbot_args=(certonly --nginx)
    if [[ "$custom" == 1 ]]; then certbot_args+=(--cert-name "$domain"); fi
    for nm in "${names[@]}"; do certbot_args+=(-d "$nm"); done
    certbot_args+=(--keep-until-expiring)
    # a changed set of names replaces the lineage's names now (no question asked)
    if [[ "$custom" == 1 ]]; then certbot_args+=(--renew-with-new-domains); fi
    certbot_args+=(--non-interactive --agree-tos --register-unsafely-without-email --deploy-hook "systemctl reload nginx")
    run certbot "${certbot_args[@]}"
    if [[ "$DRY" == 0 ]] && [[ ! -f "$cert" || ("$custom" == 1 && "$(cert_names "$cert")" != "$want") ]]; then
      if [[ -n "$backup" ]]; then mv -f -- "$backup" "$site"; else rm -f -- "$site" "$enabled"; fi
      { nginx -t > /dev/null 2>&1 && systemctl reload nginx; } || true
      fail "no certificate for ${names[*]} (does DNS for every name point at this server?)"
    fi
  else
    echo "certificate for $domain present"
  fi
  # 2) the real site
  site_content "$slug" "$port" "$auth" full "$index" "$maint" "$domain" "${aliases[@]}" | write_file "$site" 0644 root:root
  run ln -sfn "$site" "$enabled"
  nginx_apply "$site" "$enabled" "$backup"
  [[ -z "$backup" ]] || rm -f -- "$backup"
  # the live domain is recorded (app-remove deletes its certificate later); a domain it replaces gives up its
  # certificate now, so certbot never keeps renewing a name nothing serves
  if [[ "$custom" == 1 ]]; then
    have="$(recorded_domain "$slug")"
    if [[ ! -d "$DOMAINS_DIR" || -L "$DOMAINS_DIR" ]]; then
      [[ ! -L "$DOMAINS_DIR" ]] || fail "$DOMAINS_DIR is a symlink"
      run install -d -m 0700 -o root -g root "$DOMAINS_DIR"
    fi
    if [[ "$have" != "$domain" ]]; then
      printf '%s\n' "$domain" | write_file "$DOMAINS_DIR/$slug" 0600 root:root
      if [[ -n "$have" ]]; then drop_lineage "$have" "$slug"; fi
    fi
  fi
  for nm in "${aliases[@]}"; do echo "redirect https://$nm -> https://$domain"; done
  if [[ "$maint" == 1 ]]; then echo "maintenance page on (503, Retry-After 60): the app at port $port is not proxied"; fi
  echo "published https://$domain"
}

# remove_site SLUG: the app's nginx site, then nginx -t + reload (the certificate stays for a later publish)
remove_site() {
  local slug="$1" site enabled
  site="$NGINX_SITES/wfos-app-$slug"
  enabled="$NGINX_ENABLED/wfos-app-$slug"
  if [[ "$DRY" == 0 && ! -e "$site" && ! -L "$enabled" ]]; then
    echo "no site for $slug"
    return 0
  fi
  run rm -f -- "$enabled" "$site"
  if [[ "$DRY" == 1 ]] || nginx -t > /dev/null 2>&1; then
    run systemctl reload nginx
  else
    fail "nginx -t fails after removing the site; check the nginx configuration"
  fi
}

cmd_unpublish() {
  lock
  remove_site "$1"
  echo "unpublished $1"
}

# ---------------------------------------------------------------------------
# app-remove, stop-all
# ---------------------------------------------------------------------------

# keep_db_dump SLUG NAME: pg_dump -Fc of database NAME (as the app role, peer map, like db-dump) to
# REMOVED_DIR/<slug>-<UTC yyyymmddTHHMMZ>.dump (root 0600) → KEPT_DUMP (`none` when there is no such database).
# Fails (exit 1) when the cluster does not answer or the dump fails: app-remove then has removed nothing. Dumps
# older than REMOVED_KEEP_DAYS days are pruned.
KEPT_DUMP=""
keep_db_dump() {
  local slug="$1" name="$2" out file tmp f
  if [[ "$DRY" == 0 ]]; then
    out="$(runuser -u postgres -- "$(pg_bin psql)" -X -tA -h "$PG_SOCK" -p "$C_PG_PORT" -d postgres -c "SELECT 1 FROM pg_database WHERE datname = '$name'")" ||
      fail "the apps cluster does not answer: nothing was removed"
    if [[ "$out" != 1 ]]; then
      echo "no database $name: no dump to keep"
      KEPT_DUMP=none
      return 0
    fi
  fi
  [[ ! -L "$REMOVED_DIR" ]] || fail "$REMOVED_DIR is a symlink: nothing was removed"
  if [[ ! -d "$REMOVED_DIR" ]]; then run install -d -m 0700 -o root -g root "$REMOVED_DIR"; fi
  file="$REMOVED_DIR/$slug-$(date -u +%Y%m%dT%H%MZ).dump"
  if [[ "$DRY" == 1 ]]; then
    echo "[dry-run] runuser -u postgres -- $(pg_bin pg_dump) -h $PG_SOCK -p $C_PG_PORT -U $name -Fc -d $name > $file (root-owned, mode 0600, via a temp file)"
  else
    tmp="$(mktemp "$REMOVED_DIR/.wfos-tmp.XXXXXX")"
    if ! runuser -u postgres -- "$(pg_bin pg_dump)" -h "$PG_SOCK" -p "$C_PG_PORT" -U "$name" -Fc -d "$name" > "$tmp"; then
      rm -f -- "$tmp"
      fail "pg_dump of $name failed: nothing was removed"
    fi
    chmod 0600 "$tmp"
    mv -fT -- "$tmp" "$file"
  fi
  KEPT_DUMP="$file"
  while IFS= read -r -d '' f; do
    run rm -f -- "$f"
  done < <(find "$REMOVED_DIR" -maxdepth 1 -type f -name '*.dump' -mtime "+$REMOVED_KEEP_DAYS" -print0 2> /dev/null)
}

cmd_app_remove() {
  local slug="$1" drop="$2" keep="$3" user dir unit name site live c s
  local -a certs=() starts=()
  user="$(app_user "$slug")"
  dir="$(app_dir "$slug")"
  unit="$(unit_name "$slug")"
  name="$(db_name "$slug")"
  site="$NGINX_SITES/wfos-app-$slug"
  [[ "$drop" == 0 ]] || require_pg
  check_apps_root
  if acct passwd "$user" > /dev/null && ! our_user "$user" "$slug"; then
    fail "user $user was not made by wfos-app-helper: refusing to remove anything"
  fi
  if acct group "$user" > /dev/null && ! our_group "$user"; then
    fail "group $user was not made by wfos-app-helper: refusing to remove anything"
  fi
  # the build (if any) is stopped first, so this never waits for it
  if [[ "$DRY" == 1 ]]; then
    run systemctl stop "$(build_unit "$slug")"
  else
    systemctl stop "$(build_unit "$slug")" 2> /dev/null || true
  fi
  lock
  # the database is kept first: when that fails, nothing has been removed
  if [[ "$keep" == 1 ]]; then keep_db_dump "$slug" "$name"; fi
  # its certificates: the preview name and the live domain it published (recorded by publish, or read from its site)
  certs=("$slug.$C_BASE_DOMAIN")
  live="$(recorded_domain "$slug")"
  if [[ -z "$live" && -f "$site" && ! -L "$site" ]]; then
    live="$(sed -nE 's|^[[:space:]]*ssl_certificate /etc/letsencrypt/live/([^/]+)/fullchain\.pem;$|\1|p' -- "$site" | head -1)"
  fi
  if [[ -n "$live" && "$live" != "${certs[0]}" ]]; then certs+=("$live"); fi
  # the instance's unit, and both slots of a live instance
  if [[ "$DRY" == 1 || -f "$(unit_path "$slug")" ]]; then
    run systemctl disable --now "$unit"
    run rm -f -- "$(unit_path "$slug")"
    run systemctl daemon-reload
  fi
  starts=("$(start_file "$slug")")
  if [[ "$slug" == *-live ]]; then
    for s in blue green; do
      starts+=("$(start_file "$slug" "$s")")
      if [[ -e "$(unit_path "$slug" "$s")" || -L "$(unit_path "$slug" "$s")" ]]; then
        run systemctl disable --now "$(unit_name "$slug" "$s")"
        run rm -f -- "$(unit_path "$slug" "$s")"
        run systemctl daemon-reload
      fi
    done
  fi
  if [[ "$DRY" == 0 ]]; then
    systemctl reset-failed "$unit" "$(build_unit "$slug")" 2> /dev/null || true
    if [[ "$slug" == *-live ]]; then systemctl reset-failed "$(unit_name "$slug" blue)" "$(unit_name "$slug" green)" 2> /dev/null || true; fi
  fi
  remove_site "$slug"
  run rm -f -- "$(env_file "$slug")" "${starts[0]}" "$HTPASSWD_DIR/$slug" "${starts[@]:1}"
  # after the site is gone (nginx no longer loads the files), best effort: certbot stops renewing them
  for c in "${certs[@]}"; do drop_lineage "$c" "$slug"; done
  if [[ -e "$DOMAINS_DIR/$slug" || -L "$DOMAINS_DIR/$slug" ]]; then run rm -f -- "$DOMAINS_DIR/$slug"; fi
  if [[ "$drop" == 1 ]]; then
    [[ "$DRY" == 0 ]] || echo "[dry-run] stdin: DROP DATABASE IF EXISTS $name WITH (FORCE); DROP ROLE IF EXISTS $name"
    psql_apps << EOF
\\set name '$name'
SELECT format('DROP DATABASE IF EXISTS %I WITH (FORCE)', :'name') \\gexec
SELECT format('DROP ROLE IF EXISTS %I', :'name') \\gexec
EOF
    auth_set "$name" "$user" remove
  fi
  # the whole app folder (releases, data, cache, backups); a planted symlink is removed itself, never followed
  if [[ -L "$dir" ]]; then
    run rm -f -- "$dir"
  elif [[ -e "$dir" ]]; then
    run rm -rf --one-file-system -- "$dir"
  fi
  if acct passwd "$user" > /dev/null; then
    if [[ "$DRY" == 1 ]]; then
      run pkill -KILL -u "$user"
    else
      pkill -KILL -u "$user" 2> /dev/null || true
    fi
    run userdel "$user"
  fi
  if acct group "$user" > /dev/null; then run groupdel "$user"; fi
  echo "app $slug removed"
  if [[ "$keep" == 1 ]]; then echo "kept database dump: $KEPT_DUMP"; fi
}

cmd_stop_all() {
  local f n
  local -a units=()
  # no lock: an emergency stop never waits for a build or a publish. Running builds stop too.
  if [[ "$DRY" == 1 ]]; then
    run systemctl stop 'wfos-build-*.service'
  else
    systemctl stop 'wfos-build-*.service' 2> /dev/null || true
  fi
  for f in "$UNIT_DIR"/wfos-app-*.service; do
    n="$(basename -- "$f")"
    # an instance's unit (2 to 35 characters) or a slot of a live instance (+ -blue / -green)
    if [[ -f "$f" && "$n" =~ ^wfos-app-[a-z0-9-]{2,41}\.service$ ]]; then units+=("$n"); fi
  done
  if ((${#units[@]} == 0)); then
    echo "no app units"
    return 0
  fi
  run systemctl disable --now "${units[@]}"
  echo "stopped ${#units[@]} apps"
}

# ---------------------------------------------------------------------------
# dispatch (all arguments and stdin are validated before anything runs)
# ---------------------------------------------------------------------------

cmd="${1:-}"
[[ $# -gt 0 ]] && shift
nargs() { [[ "$1" == "$2" ]] || usage "$cmd: wrong number of arguments"; }
flag() { if [[ "$1" == "$2" ]]; then echo 1; else echo 0; fi; }
# with_slot NAME SLOT: SLOT (blue or green) for NAME, a live instance; exit 2 otherwise
with_slot() {
  check_slot "$2"
  check_slot_name "$1"
}

case "$cmd" in
  version)
    nargs $# 0
    echo "$HELPER_VERSION"
    ;;
  info)
    nargs $# 0
    read_conf
    cmd_info
    ;;
  app-init)
    nargs $# 1
    read_conf
    check_name "$1"
    cmd_app_init "$1"
    ;;
  release-unpack)
    nargs $# 2
    read_conf
    check_name "$1"
    check_sha "$2"
    cmd_release_unpack "$1" "$2"
    ;;
  env-install)
    nargs $# 1
    read_conf
    check_name "$1"
    cmd_env_install "$1"
    ;;
  build-run)
    nargs $# 5
    read_conf
    check_name "$1"
    check_sha "$2"
    check_step "$3"
    check_timeout "$4"
    check_mem "$5"
    cmd_build_run "$1" "$2" "$3" "$4" "$5"
    ;;
  db-create)
    [[ $# -eq 1 || ($# -eq 2 && "${2:-}" == --reset-password) ]] || usage "db-create <name> [--reset-password]"
    read_conf
    check_name "$1"
    cmd_db_create "$1" "$(flag $# 2)"
    ;;
  db-dump)
    [[ $# -eq 2 || ($# -eq 5 && "$3" == --keep-kind) ]] || usage "db-dump <name> <backup> [--keep-kind <prefix> <n>]"
    read_conf
    check_name "$1"
    check_backup_name "$2"
    if (($# == 5)); then check_keep_kind "$2" "$4" "$5"; fi
    cmd_db_dump "$1" "$2" "${4:-}" "${5:-}"
    ;;
  db-restore)
    nargs $# 2
    read_conf
    check_name "$1"
    check_backup_name "$2"
    cmd_db_restore "$1" "$2"
    ;;
  db-backups)
    nargs $# 1
    read_conf
    check_name "$1"
    cmd_db_backups "$1"
    ;;
  release-activate)
    [[ $# -eq 2 || ($# -eq 4 && "$3" == --slot) ]] || usage "release-activate <name> <sha> [--slot blue|green]"
    read_conf
    check_name "$1"
    check_sha "$2"
    if (($# == 4)); then with_slot "$1" "$4"; fi
    cmd_release_activate "$1" "$2" "${4:-}"
    ;;
  release-prune)
    nargs $# 1
    read_conf
    check_name "$1"
    cmd_release_prune "$1"
    ;;
  unit-install)
    ui_usage="unit-install <name> <port> <memMB> [--database] [--slot blue|green]"
    (($# >= 3)) || usage "$ui_usage"
    ui_name="$1" ui_port="$2" ui_mem="$3" ui_db=0 ui_has_slot=0 ui_slot=""
    shift 3
    while (($# > 0)); do
      case "$1" in
        --database)
          ((ui_db == 0)) || usage "unit-install: --database given twice"
          ui_db=1
          ;;
        --slot)
          ((ui_has_slot == 0)) || usage "unit-install: --slot given twice"
          (($# >= 2)) || usage "unit-install: --slot needs blue or green"
          ui_has_slot=1 ui_slot="$2"
          shift
          ;;
        *) usage "$ui_usage" ;;
      esac
      shift
    done
    read_conf
    check_name "$ui_name"
    check_port "$ui_port"
    check_mem "$ui_mem"
    if ((ui_has_slot)); then with_slot "$ui_name" "$ui_slot"; fi
    cmd_unit_install "$ui_name" "$ui_port" "$ui_mem" "$ui_db" "$ui_slot"
    ;;
  unit-start | unit-stop | unit-restart | unit-status)
    [[ $# -eq 1 || ($# -eq 3 && "$2" == --slot) ]] || usage "$cmd <name> [--slot blue|green]"
    read_conf
    check_name "$1"
    if (($# == 3)); then with_slot "$1" "$3"; fi
    if [[ "$cmd" == unit-status ]]; then cmd_unit_status "$1" "${3:-}"; else cmd_unit_action "$cmd" "$1" "${3:-}"; fi
    ;;
  slots)
    nargs $# 1
    read_conf
    check_name "$1"
    cmd_slots "$1"
    ;;
  health)
    nargs $# 3
    read_conf
    check_name "$1"
    check_port "$2"
    check_health_path "$3"
    cmd_health "$1" "$2" "$3"
    ;;
  publish)
    (($# >= 2)) || usage "publish <name> <port> [--auth] [--domain <fqdn> [--alias <fqdn>]...] [--index] [--maintenance]"
    pub_name="$1" pub_port="$2" pub_auth=0 pub_index=0 pub_maint=0 pub_has_domain=0 pub_domain=""
    pub_aliases=()
    shift 2
    while (($# > 0)); do
      case "$1" in
        --auth)
          ((pub_auth == 0)) || usage "publish: --auth given twice"
          pub_auth=1
          ;;
        --index)
          ((pub_index == 0)) || usage "publish: --index given twice"
          pub_index=1
          ;;
        --maintenance)
          ((pub_maint == 0)) || usage "publish: --maintenance given twice"
          pub_maint=1
          ;;
        --domain)
          ((pub_has_domain == 0)) || usage "publish: --domain given twice"
          (($# >= 2)) || usage "publish: --domain needs a host name"
          pub_has_domain=1 pub_domain="$2"
          shift
          ;;
        --alias)
          (($# >= 2)) || usage "publish: --alias needs a host name"
          pub_aliases+=("$2")
          shift
          ;;
        *) usage "publish: unknown option ${1@Q}" ;;
      esac
      shift
    done
    ((${#pub_aliases[@]} == 0 || pub_has_domain == 1)) || usage "publish: --alias needs --domain"
    ((${#pub_aliases[@]} <= 3)) || usage "publish: at most 3 aliases"
    read_conf
    check_name "$pub_name"
    check_port "$pub_port"
    if ((pub_has_domain)); then
      check_live_domain "$pub_domain" --domain
      pub_seen=" $pub_domain "
      for a in "${pub_aliases[@]}"; do
        check_live_domain "$a" --alias
        [[ "$pub_seen" != *" $a "* ]] || usage "publish: $a is given twice (domain and aliases must differ)"
        pub_seen+="$a "
      done
    fi
    cmd_publish "$pub_name" "$pub_port" "$pub_auth" "$pub_index" "$pub_maint" "$pub_domain" "${pub_aliases[@]}"
    ;;
  unpublish)
    nargs $# 1
    read_conf
    check_name "$1"
    cmd_unpublish "$1"
    ;;
  app-remove)
    (($# >= 1 && $# <= 3)) || usage "app-remove <name> [--drop-db] [--keep-db-dump]"
    rm_name="$1" rm_drop=0 rm_keep=0
    shift
    for a in "$@"; do
      case "$a" in
        --drop-db)
          ((rm_drop == 0)) || usage "app-remove: --drop-db given twice"
          rm_drop=1
          ;;
        --keep-db-dump)
          ((rm_keep == 0)) || usage "app-remove: --keep-db-dump given twice"
          rm_keep=1
          ;;
        *) usage "app-remove <name> [--drop-db] [--keep-db-dump]" ;;
      esac
    done
    ((rm_keep == 0 || rm_drop == 1)) || usage "app-remove: --keep-db-dump needs --drop-db"
    read_conf
    check_name "$rm_name"
    cmd_app_remove "$rm_name" "$rm_drop" "$rm_keep"
    ;;
  stop-all)
    nargs $# 0
    read_conf
    cmd_stop_all
    ;;
  "")
    usage "missing command (version, info, app-init, release-unpack, env-install, build-run, db-create, db-dump, db-restore, db-backups, release-activate, release-prune, unit-install, unit-start, unit-stop, unit-restart, unit-status, slots, health, publish, unpublish, app-remove, stop-all)"
    ;;
  *)
    usage "unknown command ${cmd@Q}"
    ;;
esac
