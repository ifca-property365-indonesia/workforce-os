{
  "name": "workforce-os",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:web": "pnpm --filter @wfos/web dev",
    "dev:worker": "pnpm --filter @wfos/worker dev",
    "build": "pnpm --filter @wfos/web build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @wfos/db generate",
    "db:migrate": "pnpm --filter @wfos/db migrate",
    "db:seed": "pnpm --filter @wfos/db seed"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
